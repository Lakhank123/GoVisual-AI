# GoVisual AI — Environment Variables
# Copy this file to .env and fill in your actual keys

# Google Places API (for brand lookup)
GOOGLE_PLACES_API_KEY=

# Gemini API (for image generation)
GEMINI_API_KEY=

# OpenAI API (for image generation, photoshoot, brandbook, and miniwebsite)
OPENAI_API_KEY=

# HuggingFace API token for FLUX.1-schnell fallback image generation
HF_API_TOKEN=

# T5 Model path (local directory or HuggingFace repo)
T5_MODEL_PATH=./ml_model

# Cloudinary (for image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to "true" to save images locally instead of Cloudinary
USE_LOCAL_STORAGE=true

# Watermark image path
WATERMARK_PATH=./watermark.png

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Meta / Instagram Graph API Configuration (for Instagram Professional Direct Publishing)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Token Encryption (Fernet 32-byte url-safe base64 key or passphrase for encrypting tokens at rest)
TOKEN_ENCRYPTION_KEY=

# SaaS Commercial Billing & Razorpay Gateway Configuration
# PAYMENT_GATEWAY_MODE: "mock" (for headless tests/dev), "test" (Razorpay sandbox), or "live" (production)
PAYMENT_GATEWAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_EMAILS=admin@govisual.ai
