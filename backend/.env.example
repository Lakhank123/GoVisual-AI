# GoVisual AI — Backend Environment Variables
# Copy this file to .env and fill in your actual keys

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Places API (for brand lookup)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# AI Providers (LLM, Vision & Image Generation)
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

HF_API_TOKEN=your_huggingface_api_token

# Orchestration & Pipeline Configuration
BRAND_INTELLIGENCE_PROVIDER=groq
IMAGE_PROVIDER=openai
IMAGE_MODE=auto
ENABLE_CRITIC=true
BACKGROUND_REMOVAL=true
SHADOWS=true
REFLECTIONS=true
EDGE_REFINEMENT=true
SAVE_DEBUG_IMAGES=false

# T5 Prompt Engine Configuration
T5_MODEL_PATH=./ml_model
T5_ALLOW_FALLBACK=true

# Storage & Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
USE_LOCAL_STORAGE=true
VIDEO_OUTPUT_DIR=./generated_videos
WATERMARK_PATH=./watermark.png

# CORS & Public URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# Meta / Instagram Graph API Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Token Encryption (Fernet 32-byte url-safe base64 key)
TOKEN_ENCRYPTION_KEY=your_fernet_token_encryption_key

# SaaS Commercial Billing & Razorpay Gateway Configuration
# PAYMENT_GATEWAY_MODE: "mock" (dev/tests), "test" (Razorpay sandbox), or "live" (production)
PAYMENT_GATEWAY_MODE=mock
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
ADMIN_EMAILS=admin@govisual.ai
